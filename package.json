{
  "name": "contador-calorias",
  "version": "1.1.0",
  "private": true,
  "description": "App para contar calorías con código de barras, macros por IA, recordatorios y calculador de objetivos. PWA + Capacitor.",
  "scripts": {
    "serve": "npx serve -p 3000 .",
    "icons": "npx serve -p 3001 . & open http://localhost:3001/tools/generate-icons.html",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:assets": "npx @capacitor/assets generate --android --iconBackgroundColor '#0f172a' --splashBackgroundColor '#0f172a'"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/assets": "^3.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0"
  }
}
